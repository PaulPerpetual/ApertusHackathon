# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works (CSCS/Keera gateway, Hugging Face router, local vLLM).
LLM_NAME=apertus-v1-5-70b
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_API_KEY=your-team-key-from-the-organizers
# Optional
# LLM_MAX_INPUT_CHARS=24000     # judgement text sent to the model (truncated)
# RELEVANCE_SUMMARY_THRESHOLD=60  # summarize judgements scoring at least this
# SUVA_DB=data/suva.sqlite
